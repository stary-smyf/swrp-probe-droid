VertexLitGeneric
{
    $basetexture    "effects/splinter_cell/thermal_noise"
//    $bumpmap    "effects/splinter_cell/thermal_radius"
    $color2    "[ 1 1 1 ]"
//    $additive    1
    $nocull    1

//    $cloakpassenabled    1
    $cloakfactor    0
    $cloakcolortint    "[ 0 2 1 ]"
    $refractamount    0

    $normalmapalphaenvmapmask    1
   // $phong    1
    $phongboost    5
    $phongexponent    18
    $phongfresnelranges    "[ .03 3 1 ]"
    $phongtint    "[ 0 8 .8 ]"

    "Proxies"
    {
        TextureScroll
        {
            textureScrollVar    $basetexturetransform
            textureScrollRate    0.01
            textureScrollAngle    45
        }

        AnimatedTexture
        {
            "animatedtexturevar" "$bumpmap"
            "animatedtextureframenumvar" "$bumpframe"
            "animatedtextureframerate" 5.00
        }
    }
}