"VertexlitGeneric"
{

	"$basetexture" "effects/splinter_cell/thermal_radius"
//	"$bumpmap"	"vgui/black"
	"$lightwarptexture" "effects/splinter_cell/thermal_radius"
	"$detail"	"effects/splinter_cell/thermal_noise"
	"$detailscale"2
	"$detailblendmode"	1
	"$detailblendfactor"	2
	$emissiveBlendEnabled 1
	$emissiveBlendTexture     		"effects/splinter_cell/thermal_radius"
	$emissiveBlendBaseTexture		"effects/splinter_cell/thermal_radius"
	$emissiveBlendFlowTexture     	"effects/splinter_cell/thermal_noise"
	$emissiveBlendTint "[1 75 80]"
	$emissiveBlendStrength 15
	$emissiveBlendScrollVector "[0 0]"
	"$vertexcolor" 1
	"$nodecal" 1
	"$nocull"	1
	"$model"	1
//	"$selfillum"	1
	"$selfillumtint"	"[1 1 1]"

	// Flesh Interior Pass
	"$FleshInteriorEnabled"      		"1" // Enables effect
	"$FleshInteriorTexture"      		"effects/splinter_cell/thermal_radius" // Mask in alpha
	"$FleshNormalTexture"		 "effects/splinter_cell/thermal_spectrum"
//	"$FleshBorderTexture1D"      		"effects/splinter_cell/thermal_noise"
	"$FleshInteriorNoiseTexture" 		"vgui/splinter_cell/SFX_RainAlpha_full"
	"$FleshSubsurfaceTexture"	 	"effects/splinter_cell/thermal_radius"
	"$FleshCubeTexture"          		"effects/splinter_cell/thermal_radius"
	"$FleshBorderNoiseScale"    		 ".001" // Flesh Noise UV scalar for border
	"$FleshBorderWidth"		"2" // Width of flesh border
	"$FleshBorderSoftness"		 "0.5" // Border softness must be greater than 0.0 and up tp 0.5
	"$FleshBorderTint"			 "[2 1.75 1.35]" // Tint / brighten the border 1D texture
	"$FleshGlossBrightness"		 "4.0" // Change the brightness of the glossy layer
	"$FleshDebugForceFleshOn"	 	"1" // DEBUG: This will force on full flesh for testing
	"$FleshScrollSpeed"		 "0.01"
	"$Time" "0.0"
	"Proxies"
	{
		"FleshInterior"
		{
		}
		"MaterialModify"
		{
		}
		"CurrentTime"
		{
			"resultVar" "$time"
		}
	}

}