
"Modulate"
 {
$basetexture              "vgui\white" //Multiplies the color behind it with this surface's texture.
$basetexturetransform	"center .5 .5 scale 6 8 rotate 0  translate 0 0"
$mod2x                    "1"  
$vertexalpha	"1"
$vertexcolor	"1"
//$color2		"[0.5 5.0 0.5]"

"Proxies"
        {
                "AnimatedTexture"
                {
                         "animatedtexturevar" "$basetexture"
                         "animatedtextureframenumvar" "$frame"
                         "animatedtextureframerate" 60.00
                }

        }

}


