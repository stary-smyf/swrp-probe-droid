UnlitGeneric
{
	$basetexture "vgui/splinter_cell/overlay_noise"
	$translucent 	1
	$vertexalpha  1
	$vertexcolor   1
	$additive     1
        "Proxies"
        {
                "AnimatedTexture"
                {
                         "animatedtexturevar" "$basetexture"
                         "animatedtextureframenumvar" "$frame"
                         "animatedtextureframerate" 20.00
                }

        }
}